# Copy this file to .env (already gitignored — never commit real keys, FR-M8-08).

# AI module (src/ai.js, FR-M8-06). Leave as mock, or just leave AI_API_KEY unset,
# to run without any AI provider — this is what tests and CI always use.
AI_MODE=mock

# Set once an AI provider is chosen (SRS constraint C-2: Gemini API or GitHub Models)
# and AI_MODE is switched away from mock.
# AI_API_KEY=
